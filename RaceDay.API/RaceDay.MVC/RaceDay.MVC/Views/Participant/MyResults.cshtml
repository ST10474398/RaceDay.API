@model List<RaceDay.MVC.Models.MyResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-primary"><i class="bi bi-trophy-fill text-warning"></i> My Results</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4>You don't have any results yet.</h4>
            <p>Once an organiser records a finish time for an event you attended, it will appear here.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var result in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-dark text-warning fw-bold">
                            @result.EventName
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3"><i class="bi bi-calendar"></i> @result.EventDate.ToString("dd MMM yyyy")</p>

                            <div class="row text-center">
                                <div class="col-6 border-end">
                                    <h5 class="text-muted mb-1">Finish Time</h5>
                                    <h3 class="fw-bold text-success">@result.FinishTime</h3>
                                </div>
                                <div class="col-6">
                                    <h5 class="text-muted mb-1">Position</h5>
                                    <h3 class="fw-bold text-primary">#@result.Position</h3>
                                </div>
                            </div>

                            @if (result.IsVerified)
                            {
                                <div class="text-center mt-3">
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Verified by Organiser</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
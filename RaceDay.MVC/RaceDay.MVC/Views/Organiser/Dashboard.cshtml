@model List<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <!-- Header Row -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary" style="font-size: 2.5rem;">
            <i class="bi bi-bar-chart-fill text-dark"></i> Organiser Dashboard
        </h1>
        <a asp-controller="Events" asp-action="Create" class="btn btn-warning btn-lg fw-bold rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg"></i> Create New Event
        </a>
    </div>

    <!-- Events Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ev in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body p-4">
                        <!-- Status Badge -->
                        <span class="badge bg-dark text-white mb-2 text-uppercase px-3 py-2 rounded-pill" style="font-size: 0.75rem;">
                            @ev.Status
                        </span>

                        <!-- Event Title -->
                        <h4 class="card-title fw-bold mb-1">@ev.Name</h4>

                        <!-- Location -->
                        <p class="text-muted mb-3"><i class="bi bi-geo-alt"></i> @ev.Location</p>

                        <!-- Enrolments Count with Badge -->
                        <p class="text-muted small mb-4">
                            <i class="bi bi-people-fill"></i> Total Enrolments:
                            <span class="badge bg-info text-dark">@ev.TotalEnrolments</span>
                        </p>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-column gap-2">
                            <a asp-controller="Organiser" asp-action="ViewEnrolments" asp-route-id="@ev.EventID" class="btn btn-outline-primary fw-bold px-4 rounded-2 w-100">
                                <i class="bi bi-people"></i> View Enrolments
                            </a>
                            <a asp-controller="Organiser" asp-action="EnterResults" asp-route-id="@ev.EventID" class="btn btn-outline-warning fw-bold px-4 rounded-2 w-100">
                                <i class="bi bi-stopwatch"></i> Enter Results
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
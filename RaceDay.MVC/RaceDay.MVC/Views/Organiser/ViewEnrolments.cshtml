@model List<RaceDay.MVC.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "View Enrolments";
    var eventId = ViewBag.EventID;
}

<div class="container mt-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Enrolments for: <span class="text-primary">@ViewBag.EventName</span></h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary fw-bold">Back to Dashboard</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4>No one has enrolled yet.</h4>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Participant Name</th>
                            <th>Email</th>
                            <th>Date Enrolled</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var en in Model)
                        {
                            <tr>
                                <td class="fw-bold">@en.ParticipantName</td>
                                <td>@en.ParticipantEmail</td>
                                <td>@en.EnrolledAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    @if (en.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (en.Status == "Rejected")
                                    {

                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (en.Status == "Pending")
                                    {
                                        <form asp-action="UpdateEnrolmentStatus" method="post" class="d-inline">
                                            <input type="hidden" name="enrolmentId" value="@en.EnrolmentID" />
                                            <input type="hidden" name="eventId" value="@eventId" />
                                            <input type="hidden" name="status" value="Approved" />
                                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                        </form>
                                        <form asp-action="UpdateEnrolmentStatus" method="post" class="d-inline">
                                            <input type="hidden" name="enrolmentId" value="@en.EnrolmentID" />
                                            <input type="hidden" name="eventId" value="@eventId" />
                                            <input type="hidden" name="status" value="Rejected" />
                                            <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
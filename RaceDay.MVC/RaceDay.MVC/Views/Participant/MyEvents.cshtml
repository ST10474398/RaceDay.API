@model List<RaceDay.MVC.Models.MyEnrolmentViewModel>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-primary"><i class="bi bi-ticket-perforated"></i> My Enrolled Events</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <h4>You haven't enrolled in any events yet.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-2 fw-bold">Browse Events</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title fw-bold mb-0">@item.EventName</h5>

                                <!-- Status Badge -->
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == "Rejected")
                                {

                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else if (item.Status == "Cancelled")
                                {

                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </div>

                            <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @item.EventLocation</p>
                            <p class="text-muted small"><i class="bi bi-calendar"></i> @item.EventDate.ToString("dd MMM yyyy")</p>

                            <hr />
                            <div class="text-muted small">
                                Enrolled on: @item.EnrolledAt.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>